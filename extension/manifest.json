{
  "manifest_version": 3,
  "name": "Slop AI",
  "version": "1.0.0",
  "description": "Detects AI slop and fake reviews using linguistic analysis. Filters low-information-density content.",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ]
}
