{
  "manifest_version": 3,
  "name": "Information Density Filter",
  "version": "1.0.0",
  "description": "Filters low-information-density content. Surfaces pages that actually teach you something.",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ]
}
